PHP_METHOD(DateTimeZone, __set_state)
{
	php_timezone_obj *tzobj;
	zval             *array;
	HashTable        *myht;

	if (zend_parse_parameters(ZEND_NUM_ARGS() TSRMLS_CC, ""a"", &array) == FAILURE) {
		RETURN_FALSE;
	}

	myht = HASH_OF(array);

	php_date_instantiate(date_ce_timezone, return_value TSRMLS_CC);
	tzobj = (php_timezone_obj *) zend_object_store_get_object(return_value TSRMLS_CC);
	php_date_timezone_initialize_from_hash(&return_value, &tzobj, myht TSRMLS_CC);",1,,php-src,c377f1a715476934133f3254d1e0d4bf3743e2d2,227061508458318127463413507991216241612,16,Fix bug #68942 (Use after free vulnerability in unserialize() with DateTimeZone)

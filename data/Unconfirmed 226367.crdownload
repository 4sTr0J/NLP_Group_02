		zend_hash_del(Z_OBJPROP_P(this_ptr), ""httpsocket"", sizeof(""httpsocket""));
		zend_hash_del(Z_OBJPROP_P(this_ptr), ""_use_proxy"", sizeof(""_use_proxy""));
		stream = NULL;
		use_proxy = 0;
	}


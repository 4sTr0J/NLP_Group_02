"dfaoptimize (struct dfa *d)
{
  unsigned int i;

  if (!MBS_SUPPORT || !using_utf8())
    return;

  for (i = 0; i < d->tindex; ++i)
    {
      switch(d->tokens[i])
        {
        case ANYCHAR:
          /* Lowered.  */
          abort ();
        case MBCSET:
          /* Requires multi-byte algorithm.  */
          return;
        default:
          break;
        }
    }

  free_mbdata (d);
  d->mb_cur_max = 1;
}",1,CWE-189,grep,cbbc1a45b9f843c811905c97c90a5d31f8e6c189,221957295606013626728111009001505445135,25,"grep: fix some core dumps with long lines etc.


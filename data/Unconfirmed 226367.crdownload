"charclass_index (charclass const s)
{
  int i;

  for (i = 0; i < dfa->cindex; ++i)
    if (equal(s, dfa->charclasses[i]))
      return i;
  REALLOC_IF_NECESSARY(dfa->charclasses, dfa->calloc, dfa->cindex + 1);
  ++dfa->cindex;
  copyset(s, dfa->charclasses[i]);
  return i;
}",1,CWE-189,grep,cbbc1a45b9f843c811905c97c90a5d31f8e6c189,137040247852800165181618933349094193181,12,"grep: fix some core dumps with long lines etc.


			smart_str_appendc(buf, ';');
			return;
		} else if (Z_TYPE_P(struc) == IS_OBJECT) {
			smart_str_appendl(buf, ""r:"", 2);
			smart_str_append_long(buf, (long)*var_already);
			smart_str_appendc(buf, ';');

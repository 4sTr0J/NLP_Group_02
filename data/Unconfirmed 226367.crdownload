Security: CVE-2014-0064"
"findoprnd(ITEM *ptr, int32 *pos)
{
#ifdef BS_DEBUG
	elog(DEBUG3, (ptr[*pos].type == OPR) ?
		 ""%d  %c"" : ""%d  %d"", *pos, ptr[*pos].val);
#endif
	if (ptr[*pos].type == VAL)
	{
		ptr[*pos].left = 0;
		(*pos)--;
	}
	else if (ptr[*pos].val == (int32) '!')
	{
		ptr[*pos].left = -1;
		(*pos)--;
		findoprnd(ptr, pos);
	}
	else
	{
		ITEM	   *curitem = &ptr[*pos];
		int32		tmp = *pos;

		(*pos)--;
		findoprnd(ptr, pos);
		curitem->left = *pos - tmp;
		findoprnd(ptr, pos);
	}
}",1,"CWE-703,CWE-189",postgres,31400a673325147e1205326008e32135a78b4d8a,75851732886635934401610758366252878781,28,"Predict integer overflow to avoid buffer overruns.


"static gboolean printable_str(const char *str)
{
    do {
        if ((unsigned char)(*str) < ' ' || *str == 0x7f)
            return FALSE;
        str++;
    } while (*str);
    return TRUE;
}",1,CWE-22,abrt,c796c76341ee846cfb897ed645bac211d7d0a932,237715831510363764875991283651115531677,9,"daemon: use libreport's function checking file name


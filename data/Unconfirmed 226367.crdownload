Added a new function jas_deprecated to warn about reliance on
deprecated library behavior."
"static int mem_read(jas_stream_obj_t *obj, char *buf, int cnt)
{
	int n;
	assert(cnt >= 0);
	assert(buf);

	JAS_DBGLOG(100, (""mem_read(%p, %p, %d)\n"", obj, buf, cnt));
	jas_stream_memobj_t *m = (jas_stream_memobj_t *)obj;
	n = m->len_ - m->pos_;
	cnt = JAS_MIN(n, cnt);
	memcpy(buf, &m->buf_[m->pos_], cnt);
	m->pos_ += cnt;
	return cnt;
}",1,"CWE-415,CWE-190,CWE-369",jasper,634ce8e8a5accc0fa05dd2c20d42b4749d4b2735,264487976908721069308924850105141112988,14,"Made some changes to the I/O stream library for memory streams.

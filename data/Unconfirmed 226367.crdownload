"static int em_jcxz(struct x86_emulate_ctxt *ctxt)
{
	if (address_mask(ctxt, reg_read(ctxt, VCPU_REGS_RCX)) == 0)
		jmp_rel(ctxt, ctxt->src.val);

	return X86EMUL_CONTINUE;
}",1,,kvm,234f3ce485d54017f15cf5e0699cff4100121601,6181626804383519135482826595975736749,7,"KVM: x86: Emulator fixes for eip canonical checks on near branches


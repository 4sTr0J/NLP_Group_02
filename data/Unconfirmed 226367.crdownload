"static int rtnl_group_changelink(struct net *net, int group,
		struct ifinfomsg *ifm,
		struct nlattr **tb)
{
	struct net_device *dev;
	int err;

	for_each_netdev(net, dev) {
		if (dev->group == group) {
			err = do_setlink(dev, ifm, tb, NULL, 0);
			if (err < 0)
				return err;
		}
	}

	return 0;
}",1,CWE-264,net,90f62cf30a78721641e08737bda787552428061e,27312865428109439726522011955916168900,17,"net: Use netlink_ns_capable to verify the permisions of netlink messages


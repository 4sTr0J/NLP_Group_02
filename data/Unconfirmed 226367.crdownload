Security: CVE-2014-0064"
"findoprnd(ITEM *ptr, int32 *pos)
{
	if (ptr[*pos].type == VAL || ptr[*pos].type == VALTRUE)
	{
		ptr[*pos].left = 0;
		(*pos)++;
	}
	else if (ptr[*pos].val == (int32) '!')
	{
		ptr[*pos].left = 1;
		(*pos)++;
		findoprnd(ptr, pos);
	}
	else
	{
		ITEM	   *curitem = &ptr[*pos];
		int32		tmp = *pos;

		(*pos)++;
		findoprnd(ptr, pos);
		curitem->left = *pos - tmp;
		findoprnd(ptr, pos);
	}
}",1,"CWE-703,CWE-189",postgres,31400a673325147e1205326008e32135a78b4d8a,285705781544491357972662460055952859231,24,"Predict integer overflow to avoid buffer overruns.


"int main(void)
{
	FILE *f;
	char *tmpname;
	f = xfmkstemp(&tmpname, NULL);
	unlink(tmpname);
	free(tmpname);
	fclose(f);
	return EXIT_FAILURE;
}",1,CWE-264,util-linux,bde91c85bdc77975155058276f99d2e0f5eab5a9,126129166376004203208182096583095793285,10,"chsh, chfn, vipw: fix filenames collision


"copytoks (int tindex, int ntokens)
{
  int i;

  for (i = 0; i < ntokens; ++i)
    {
      addtok(dfa->tokens[tindex + i]);
      /* Update index into multibyte csets.  */
      if (MB_CUR_MAX > 1 && dfa->tokens[tindex + i] == MBCSET)
        dfa->multibyte_prop[dfa->tindex - 1] = dfa->multibyte_prop[tindex + i];
    }
}",1,CWE-189,grep,cbbc1a45b9f843c811905c97c90a5d31f8e6c189,296255162025239603832999508055306844448,12,"grep: fix some core dumps with long lines etc.


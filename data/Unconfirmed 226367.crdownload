"static int em_ret(struct x86_emulate_ctxt *ctxt)
{
	ctxt->dst.type = OP_REG;
	ctxt->dst.addr.reg = &ctxt->_eip;
	ctxt->dst.bytes = ctxt->op_bytes;
	return em_pop(ctxt);
}",1,,kvm,234f3ce485d54017f15cf5e0699cff4100121601,86759117583101633528214904944148383593,7,"KVM: x86: Emulator fixes for eip canonical checks on near branches


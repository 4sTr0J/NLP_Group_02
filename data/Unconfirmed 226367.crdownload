"static gboolean is_correct_filename(const char *value)
{
    return printable_str(value) && !strchr(value, '/') && !strchr(value, '.');
}",1,CWE-22,abrt,c796c76341ee846cfb897ed645bac211d7d0a932,254414467925773928908544649619730694275,4,"daemon: use libreport's function checking file name


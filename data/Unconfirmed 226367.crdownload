"  void RemoveZeroAdd(HAdd** add, HConstant** constant) {
    if (*add != NULL && (*constant)->Integer32Value() == 0) {
      (*add)->DeleteAndReplaceWith((*add)->left());
      (*constant)->DeleteAndReplaceWith(NULL);
    }
  }",1,,node,fd80a31e0697d6317ce8c2d289575399f4e06d21,221566419311731004630001130947261561905,6,"deps: backport 5f836c from v8 upstream

Original commit message:


				return NULL;
		}
	}

#if HAVE_SETLOCALE
	if (strcmp(locale, ""C""))
		tables = pcre_maketables();
#endif

	/* Compile pattern and display a warning if compilation failed. */
	re = pcre_compile(pattern,
					  coptions,
					  &error,
					  &erroffset,
					  tables);

	if (re == NULL) {
		php_error_docref(NULL TSRMLS_CC,E_WARNING, ""Compilation failed: %s at offset %d"", error, erroffset);
		efree(pattern);

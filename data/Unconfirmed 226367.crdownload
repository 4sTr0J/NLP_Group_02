"static inline long div_ll_X_l_rem(long long divs, long div, long *rem)
{
	long dum2;
	asm(""divl %2"":""=a""(dum2), ""=d""(*rem)
	    : ""rm""(div), ""A""(divs));

	return dum2;

}",1,CWE-189,linux,f8bd2258e2d520dff28c855658bd24bdafb5102d,245108688327613601972378204389228879772,9,"remove div_long_long_rem


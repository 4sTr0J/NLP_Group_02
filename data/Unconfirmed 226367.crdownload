	DEFAULT_0_PARAMS;
	
	res = estrdup("""");
	str = &res;

	trace = zend_read_property(default_exception_ce, getThis(), ""trace"", sizeof(""trace"")-1, 1 TSRMLS_CC);
	zend_hash_apply_with_arguments(Z_ARRVAL_P(trace) TSRMLS_CC, (apply_func_args_t)_build_trace_string, 3, str, len, &num);


Signed-off-by: Paolo Bonzini <pbonzini@redhat.com>"
"static inline void jmp_rel(struct x86_emulate_ctxt *ctxt, int rel)
{
	assign_eip_near(ctxt, ctxt->_eip + rel);
}",1,,kvm,234f3ce485d54017f15cf5e0699cff4100121601,114149723489396267754103707023523727859,4,"KVM: x86: Emulator fixes for eip canonical checks on near branches


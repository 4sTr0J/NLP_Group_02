"nsubtoks (int tindex)
{
  int ntoks1;

  switch (dfa->tokens[tindex - 1])
    {
    default:
      return 1;
    case QMARK:
    case STAR:
    case PLUS:
      return 1 + nsubtoks(tindex - 1);
    case CAT:
    case OR:
      ntoks1 = nsubtoks(tindex - 1);
      return 1 + ntoks1 + nsubtoks(tindex - 1 - ntoks1);
    }
}",1,CWE-189,grep,cbbc1a45b9f843c811905c97c90a5d31f8e6c189,263581662425223692954498860046035406541,18,"grep: fix some core dumps with long lines etc.


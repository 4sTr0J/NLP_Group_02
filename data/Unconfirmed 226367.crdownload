	} else {
		RETURN_NULL();
	}
	
} /* }}} */",1,CWE-416,php-src,c2e197e4efc663ca55f393bf0e799848842286f3,316557853168765940262108021463375810621,56,Fix bug #70168 - Use After Free Vulnerability in unserialize() with SplObjectStorage

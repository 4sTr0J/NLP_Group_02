Signed-off-by: Paolo Bonzini <pbonzini@redhat.com>"
"static int em_call(struct x86_emulate_ctxt *ctxt)
{
	long rel = ctxt->src.val;

	ctxt->src.val = (unsigned long)ctxt->_eip;
	jmp_rel(ctxt, rel);
	return em_push(ctxt);
}",1,,kvm,234f3ce485d54017f15cf5e0699cff4100121601,248194151005355970113307758587867959950,8,"KVM: x86: Emulator fixes for eip canonical checks on near branches


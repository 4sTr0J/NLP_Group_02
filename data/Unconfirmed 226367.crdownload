	    {
	      fail (""stringprep() entry %ld failed\n"", i);
	      if (debug)
		printf (""ERROR\n"");
	    }
	  else if (debug)
	    printf (""OK\n\n"");

	  free (p);
	}
      else if (debug)
	printf (""OK\n\n"");
    }


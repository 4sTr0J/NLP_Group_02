		file_magerror(ms, ""invalid type %d in mconvert()"", m->type);
		return 0;",1,CWE-119,php-src,e77659a8c87272e5061738a31430d2111482c426,26171586741096001099478222701411172461,131,"Fixed Bug #67410 fileinfo: mconvert incorrect handling of truncated pascal string size


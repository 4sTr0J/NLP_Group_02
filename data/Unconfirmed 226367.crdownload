"static int ip_options_get_finish(struct net *net, struct ip_options **optp,
				 struct ip_options *opt, int optlen)
{
	while (optlen & 3)
		opt->__data[optlen++] = IPOPT_END;
	opt->optlen = optlen;
	if (optlen && ip_options_compile(net, opt, NULL)) {
		kfree(opt);
		return -EINVAL;
	}
	kfree(*optp);
	*optp = opt;
	return 0;
}",1,CWE-362,linux-2.6,f6d8bd051c391c1c0458a30b2a7abcd939329259,217287622563244038430744332753537074187,14,"inet: add RCU protection to inet->opt


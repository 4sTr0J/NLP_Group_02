"static inline struct sock *pop_stack(void)
{
	struct sock *p = gc_current;
	gc_current = unix_sk(p)->gc_tree;
	return p;
}",1,,linux-2.6,1fd05ba5a2f2aa8e7b9b52ef55df850e2e7d54c9,253841771000451131198540894527911418019,6,"[AF_UNIX]: Rewrite garbage collector, fixes race.


}",1,CWE-59,ioq3,b5acc31a4da72cc3a4a6d88facb15b6214d745c6,43825329442481745300719138078651052022,9,CVE-2012-3345
"const char *Sys_TempPath( void )
{
	static TCHAR path[ MAX_PATH ];
	DWORD length;

	length = GetTempPath( sizeof( path ), path );

	if( length > sizeof( path ) || length == 0 )
		return Sys_DefaultHomePath( );
	else
		return path;

"static inline void free_chunk(struct audit_chunk *chunk)
{
	call_rcu(&chunk->head, __free_chunk);
}",1,CWE-362,linux-2.6,8f7b0ba1c853919b85b54774775f567f30006107,232660666733245287099983498954891077201,4,"Fix inotify watch removal/umount races


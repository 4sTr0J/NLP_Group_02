"void* ipc_alloc(int size)
{
	void* out;
	if(size > PAGE_SIZE)
		out = vmalloc(size);
	else
		out = kmalloc(size, GFP_KERNEL);
	return out;
}",1,"CWE-703,CWE-189",linux,6062a8dc0517bce23e3c2f7d2fea5e22411269a3,34141339192266392926959447623728440341,9,"ipc,sem: fine grained locking for semtimedop


"int is_regular_file(struct dirent *dent, const char *dirname)
{
    if (dent->d_type == DT_REG)
        return 1;
    if (dent->d_type != DT_UNKNOWN)
        return 0;

    char *fullname = xasprintf(""%s/%s"", dirname, dent->d_name);
    struct stat statbuf;
    int r = lstat(fullname, &statbuf);
    free(fullname);

    return r == 0 && S_ISREG(statbuf.st_mode);
}",1,CWE-20,libreport,1951e7282043dfe1268d492aea056b554baedb75,104929307738478124518934935815729127563,14,"lib: fix races in dump directory handling code


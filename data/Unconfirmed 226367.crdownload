"delete (position p, position_set *s)
{
  int i;

  for (i = 0; i < s->nelem; ++i)
    if (p.index == s->elems[i].index)
      break;
  if (i < s->nelem)
    for (--s->nelem; i < s->nelem; ++i)
      s->elems[i] = s->elems[i + 1];
}",1,CWE-189,grep,cbbc1a45b9f843c811905c97c90a5d31f8e6c189,326791027219665965938262335674744439825,11,"grep: fix some core dumps with long lines etc.

